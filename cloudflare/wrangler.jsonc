  "d1_databases": [
    {"binding": "AUTH_DB", "database_name": "full-training-auth", "database_id": "4aaab3a9-c02e-4818-9223-3ed9d8d3b442", "migrations_dir": "migrations"},
    {"binding": "DATA_DB", "database_name": "full-training-data", "database_id": "bf9b6cd9-ed4c-484a-bc79-03fe9c396857", "migrations_dir": "business-migrations"}
